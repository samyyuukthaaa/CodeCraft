{
  "name": "codecraft",
  "displayName": "CodeCraft",
  "description": "CodeCraft: a VS Code interface for TrueForge agents, with gated review and Code Town.",
  "version": "0.0.1",
  "publisher": "codecraft-dev",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "codecraft.openAgentPanel",
        "title": "CodeCraft: Open Agent Panel"
      },
      {
        "command": "codecraft.undoLastChange",
        "title": "CodeCraft: Undo Last Change"
      },
      {
        "command": "codecraft.stopRun",
        "title": "CodeCraft: Stop Run"
      }
    ],
    "configuration": {
      "title": "CodeCraft",
      "properties": {
        "codecraft.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge base URL. Must be a loopback address (localhost, 127.0.0.1 or ::1)."
        },
        "codecraft.primaryModel": {
          "type": "string",
          "default": "google-gemini/gemini-3-1-flash-lite",
          "description": "Model name for the primary agent, as registered in TrueForge. Keys are configured only in TrueForge."
        },
        "codecraft.fallbackModel": {
          "type": "string",
          "default": "groq/gpt-oss-120b",
          "description": "Model name for the fallback agent, as registered in TrueForge."
        },
        "codecraft.testCommand": {
          "type": "string",
          "default": "npm test",
          "description": "Command run by the run_tests tool in the workspace, after you confirm. TrueForge has no sandbox on Windows, so it runs on your machine."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "node esbuild.mjs",
    "test": "node esbuild.mjs --tests && node --test \"out/test/*.test.js\"",
    "smoke": "node esbuild.mjs --tests && node out/test/smoke.js",
    "secret-scan": "node scripts/secret-scan.mjs",
    "live-mcp": "node esbuild.mjs --tests && node out/test/live-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
